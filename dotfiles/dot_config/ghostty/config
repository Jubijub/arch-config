# Font. Name must match `ghostty +list-fonts` exactly. The package is
# ttf-iosevkaterm-nerd; "Term" is Iosevka's narrower terminal cut, and the "Mono"
# Nerd Font variant keeps icon glyphs to a single cell so they don't overflow.
# Swap to "IosevkaTerm Nerd Font" for wider, more detailed icons.
font-family = "IosevkaTerm Nerd Font Mono"
# 12 is also Ghostty's default, but pinned explicitly: Iosevka is narrower than the
# CaskaydiaCove it replaced, so 11 read as too small.
font-size = 12
theme = catppuccin-mocha
keybind = shift+enter=text:\x1b\r

# Translucent background. Only the window background is affected; glyphs stay
# fully opaque. `background-opacity-cells` would extend it to cells that set
# their own background (tmux/neovim panes), which repaint the whole area and
# otherwise stay solid -- left off so those panes remain readable.
background-opacity = 0.8
# `background-blur` is deliberately absent: Ghostty only implements it on macOS
# and KDE Plasma, and niri has no blur, so it would be a no-op here.
