{{- $role := index .roles .machine -}}
{{- if not (hasKey $role "monitor") -}}
{{- fail (printf "niri config.kdl.tmpl: role %q has no `monitor` block in .chezmoidata.yaml" .machine) -}}
{{- end -}}
{{- if not (hasKey $role "gpu") -}}
{{- fail (printf "niri config.kdl.tmpl: role %q has no `gpu` block in .chezmoidata.yaml" .machine) -}}
{{- end -}}
// niri config, rendered by chezmoi from dot_config/niri/config.kdl.tmpl for the
// "{{ .machine }}" role. Edit the template, not this file.
// Reference: https://github.com/YaLTeR/niri/wiki -- check with `niri validate`.
// niri reloads this file live; the debug (GPU) and environment blocks need a
// re-login.

// ---------------------------------------------------------------- input
input {
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
            model "pc105"
        }
{{- if $role.numlock }}
        // Keychron K0 Max numpad: without this its keys send Home/End/arrows.
        numlock
{{- end }}
        repeat-delay 600
        repeat-rate 25
    }
    touchpad {
        tap
        // natural-scroll stays OFF (Hyprland: natural_scroll = false)
    }
    // Focus follows the pointer (Hyprland follow_mouse = 1). Not a niri default.
    // "0%": only windows already fully on screen take focus, so hovering never
    // scrolls the strip by itself.
    focus-follows-mouse max-scroll-amount="0%"
}

// ---------------------------------------------------------------- output
// "<make> <model> <serial>" from `niri msg outputs`; connector names drift.
// No refresh rate in `mode`: niri picks the highest one for the resolution.
output "{{ $role.monitor.output }}" {
    mode "{{ $role.monitor.mode }}"
    scale {{ $role.monitor.scale }}
{{- if ne $role.monitor.position "auto" }}
{{- $p := splitList "x" $role.monitor.position }}
    position x={{ index $p 0 }} y={{ index $p 1 }}
{{- end }}
}

// ---------------------------------------------------------------- GPU
// Settings come from the role's `gpu` block in .chezmoidata.yaml. by-path
// symlinks are fine: niri resolves them to the device id.
debug {
    render-drm-device "{{ $role.gpu.render_device }}"
{{- range $role.gpu.ignore_devices }}
    ignore-drm-device "{{ . }}"
{{- end }}
    // Noctalia docs: lets its launcher hand focus to the app it started.
    honor-xdg-activation-with-invalid-serial
}

// ---------------------------------------------------------------- environment
environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XCURSOR_SIZE "24"
    // GTK >= 4.20 no longer composes dead keys itself on Wayland; without this
    // AltGr+` then a gave no à in GTK4 apps with the altgr-intl layout (wiki 06).
    GTK_IM_MODULE "simple"
{{- if $role.gpu.egl_vendor_json }}
    // Load only this EGL vendor so desktop apps never touch the NVIDIA dGPU.
    __EGL_VENDOR_LIBRARY_FILENAMES "{{ $role.gpu.egl_vendor_json }}"
{{- end }}
}

cursor {
    xcursor-size 24
}

// ---------------------------------------------------------------- look & feel
// Hyprland was: gaps_in 5 / gaps_out 10, 1px 45deg border, rounding 20, shadow
// range 4 color 0xee1a1a1a, blur size 3 passes 2.
layout {
    gaps 10
    center-focused-column "never"
    // A lone column sits in the middle of the screen instead of hugging the left
    // edge (the old Hyprland "center orientation" of the web workspace, now global).
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }   // mfact 0.5

    // Hyprland drew a border on EVERY window; niri's focus-ring only marks the
    // active one, so use `border` (always drawn) and turn the ring off.
    focus-ring { off; }
    // Catppuccin Mocha, same palette as greeter.toml: Mauve -> Lavender for the
    // active window, Surface1 for the others, Red for urgent.
    border {
        width 1
        active-gradient from="#cba6f7" to="#b4befe" angle=45
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
    shadow {
        on
        softness 4
        spread 0
        offset x=0 y=2
        color "#1a1a1aee"
    }
}

// Blur (niri >= 26.04), applied to Noctalia's layer surfaces only. Windows are
// opaque (Hyprland active/inactive_opacity were 1.0), so window blur would be
// invisible work for the GPU.
blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect { blur true; xray false; }
}
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect { blur true; xray false; }
}
// Noctalia's blurred wallpaper behind the Overview ([backdrop] enabled = true in
// config.toml).
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
hotkey-overlay { skip-at-startup; }

// Animations: niri's defaults (springs). `slowdown 2.0` here to tune everything.
animations { }

// ---------------------------------------------------------------- workspaces
// Named workspaces are persistent and come first, so they are workspaces 1-3 for
// the Mod+N binds. Names are Nerd Font glyphs because Noctalia's workspaces
// widget renders the name (display = "name" in config.toml), same trick as in
// Hyprland. Every new window opens centered at 50%; Mod+R / Mod+Equal / Mod+F
// widen it (the old per-workspace mfact 0.65 rule is dropped on purpose).
workspace ""      // 1 term
workspace "󰊯"     // 2 web
workspace ""      // 3 dev

// ---------------------------------------------------------------- window rules
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}
window-rule {
    // Noctalia docs: its own windows (settings, ...) float at a fixed size.
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// ---------------------------------------------------------------- autostart
spawn-at-startup "noctalia"
// aRGB lighting is NOT started here (openrgb.service user unit, wiki 06).
// xwayland-satellite is spawned by niri itself on demand (niri >= 25.08).

// ---------------------------------------------------------------- binds
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- apps (Hyprland habits kept; E for the file manager frees F for niri)
    Mod+Return  hotkey-overlay-title="Terminal (ghostty)"  { spawn "ghostty"; }
    Mod+Space   hotkey-overlay-title="Launcher (Noctalia)" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+E       hotkey-overlay-title="Files (nautilus)"    { spawn "nautilus"; }
    Mod+B       hotkey-overlay-title="Browser (chrome)"    { spawn "google-chrome-stable"; }
    Mod+V       hotkey-overlay-title="VS Code"             { spawn "code"; }
    Mod+S       hotkey-overlay-title="Control center"      { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+N       hotkey-overlay-title="Notifications"       { spawn "noctalia" "msg" "panel-toggle" "notification-history"; }
    Super+Alt+L hotkey-overlay-title="Lock"                { spawn "noctalia" "msg" "session" "lock"; }
    Alt+Tab     hotkey-overlay-title="Window switcher"     { spawn "noctalia" "msg" "window-switcher"; }

    // --- session
    Mod+W repeat=false { close-window; }
    Mod+M              { quit; }                 // was SUPER+M -> hyprshutdown; niri asks to confirm
    Ctrl+Alt+Delete    { quit; }
    Mod+Shift+P        { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // --- focus: arrows and vim keys. Left/Right walk the strip of columns,
    //     Up/Down walk the windows stacked inside a column (the "slave stack").
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+A     { focus-column-left; }     // left-hand pair, for when the right hand is on the mouse
    Mod+D     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // --- move (Super+Shift, the Hyprland habit)
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+A     { move-column-left; }
    Mod+Shift+D     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }

    // --- columns: stacking, width, size
    Mod+BracketLeft  { consume-or-expel-window-left; }   // pull this window into the column on the left / push it out
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }     // stack the next column under this one
    Mod+Period       { expel-window-from-column; }       // unstack the bottom window to the right
    Mod+R            { switch-preset-column-width; }     // 1/3 -> 1/2 -> 2/3
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }
    Mod+F            { maximize-column; }                // "master takes everything"
    Mod+Shift+F      { fullscreen-window; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+Shift+M      { maximize-window-to-edges; }
    Mod+C            { center-column; }
    Mod+Ctrl+C       { center-visible-columns; }
    Mod+T            { toggle-window-floating; }
    Mod+Shift+T      { switch-focus-between-floating-and-tiling; }
    Mod+Ctrl+T       { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }

    // --- workspaces (1-3 are the named ones above; higher numbers are dynamic)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Tab             { focus-workspace-previous; }

    // --- mouse wheel (Hyprland: SUPER+scroll = next/previous workspace)
    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+Ctrl+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    // Mod+LMB drag = move window, Mod+RMB drag = resize: built into niri, nothing to bind.

    // --- screenshots (niri's own UI; Noctalia has `noctalia msg screenshot-region` too)
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // --- media keys (through Noctalia so the OSD shows)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay        allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause       allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext        allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
{{- if $role.backlight }}
    // `-d {{ $role.backlight }}` is REQUIRED: bare brightnessctl picks nvidia_0, a phantom backlight.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-d" "{{ $role.backlight }}" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-d" "{{ $role.backlight }}" "-e4" "-n2" "set" "5%-"; }
{{- end }}
}
