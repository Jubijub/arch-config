# Deployed by chezmoi. The theme file next to this one is a chezmoi external
# (catppuccin/zathura, see .chezmoiexternal.toml.tmpl); it sets recolor=true and
# the light/dark colours (Base / Text).
include catppuccin-mocha

# Dark UI, light paper: the theme turns `recolor` on (dark page background), which
# is not wanted by default -- only the chrome (status bar, index, prompts) is dark.
set recolor false
set recolor-keephue true          # when toggled on: keep colour hues, only remap light/dark
set recolor-reverse-video true    # when toggled on: leave images alone instead of inverting them
map i recolor                     # toggle the page recolor per document

set selection-clipboard clipboard
set adjust-open "best-fit"
set window-title-basename true
set statusbar-home-tilde true
set font "Iosevka NF 11"
set guioptions ""                 # no status/command bar until needed (":" brings it back)
