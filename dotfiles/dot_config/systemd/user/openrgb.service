[Unit]
# aRGB lighting (workstation only: ASUS Aura + G.Skill DIMMs).
#
# Order matters here, and it is the opposite of the obvious one.
#
# 1. ExecStartPre applies the colour while NO server is running. A standalone
#    `openrgb` does its own detection and writes the hardware directly, which is
#    reliable. Driving colour through a RUNNING server as an SDK client is not:
#    it repeatedly reported success (exit 0) while the LEDs never changed.
#
# 2. ExecStart then starts the resident server, which does NOT disturb the colours
#    already set -- it only keeps a client attached. That matters because the ASUS
#    Aura controller reverts to blank a minute or two after the last host
#    disconnects. A one-shot "apply then exit" cannot hold the lighting.
#
# Beware when debugging: the Aura controller RETAINS its last colour across a warm
# reboot, so the lighting can look correct after a reboot even when nothing applied
# it. To test honestly, set a different colour first (green), then reboot.
Description=OpenRGB aRGB lighting (colour, then resident server)
Documentation=https://openrgb.org
After=default.target

[Service]
Type=simple

# Leading "-": a failure here must not stop the server from starting, because the
# server is what prevents blanking. The helper polls for the hardware, so allow
# more than the default start timeout for a cold boot.
ExecStartPre=-%h/.local/bin/openrgb-apply
ExecStart=/usr/bin/openrgb --server
TimeoutStartSec=120

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
