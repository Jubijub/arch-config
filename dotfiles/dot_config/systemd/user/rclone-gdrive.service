# Deployed by chezmoi. Google Drive as a FUSE mount, browsed like a folder in
# Nautilus (wiki 06b, "Google Drive (rclone)"). Enable once by hand:
#   systemctl --user enable --now rclone-gdrive.service
[Unit]
Description=Google Drive (rclone FUSE mount at %h/GoogleDrive)
# Needs ~/.config/rclone/rclone.conf, created once by `rclone config` (holds OAuth
# tokens, deliberately not chezmoi-managed).
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
# --vfs-cache-mode full: on-demand local cache (a file is downloaded when opened,
# writes upload in the background); NOT a mirror, so a 2 TB Drive costs at most
# the cache cap locally.
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
    --cache-dir %h/.cache/rclone \
    --vfs-cache-mode full \
    --vfs-cache-max-size 10G \
    --vfs-cache-max-age 168h \
    --dir-cache-time 1h \
    --poll-interval 1m \
    --umask 077 \
    --log-level NOTICE
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
