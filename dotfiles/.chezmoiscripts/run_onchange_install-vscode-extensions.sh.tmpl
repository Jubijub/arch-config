#!/usr/bin/env bash
#
# Installs the VSCode extensions listed in vscode-extensions.txt.
#
# Extensions are not files, so chezmoi cannot manage them the way it manages
# settings.json. This is OS-independent on purpose: it works on Arch and on
# macOS, so the editor ends up with the same extension set everywhere.
#
# Skipped silently when the `code` CLI is absent (VSCode not installed, or a
# headless machine) -- that is not an error worth failing `chezmoi apply` over.
#
# run_onchange_: the list hash at the bottom makes this re-run only when the
# extension list changes. `code --install-extension` is idempotent; already
# installed extensions are reported and skipped.
set -uo pipefail

if ! command -v code >/dev/null 2>&1; then
    echo "code CLI not found -- skipping VSCode extension install."
    exit 0
fi

EXTENSIONS="{{ .chezmoi.sourceDir }}/vscode-extensions.txt"
failed=0

while read -r line || [ -n "$line" ]; do
    # strip trailing comments and surrounding whitespace, skip blanks/comments
    ext="${line%%#*}"
    ext="$(echo "$ext" | tr -d '[:space:]')"
    [ -z "$ext" ] && continue
    if ! code --install-extension "$ext" --force; then
        echo "  FAILED: $ext" >&2
        failed=1
    fi
done < "$EXTENSIONS"

if [ "$failed" -ne 0 ]; then
    echo "Some extensions failed to install (see above)." >&2
fi
echo "Done."

# --- change detection (do not edit): extension list hash ---
# vscode-extensions.txt  {{ include "vscode-extensions.txt" | sha256sum }}
