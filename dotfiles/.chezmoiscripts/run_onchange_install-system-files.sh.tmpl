#!/usr/bin/env bash
#
# Installs the repo's system/ drop-in files into /etc. chezmoi only manages
# files under $HOME, so these "pure copy" system files are deployed here instead,
# on `chezmoi apply`. This uses sudo, so `chezmoi apply` will prompt for a
# password when any of these files change.
#
# This is ONLY for files that are copied verbatim. In-place edits of
# package-created files (greetd/config.toml, mkinitcpio.conf, pacman.conf,
# bootloader entries, the localectl-generated 00-keyboard.conf, ...) are NOT
# here -- they stay documented as manual steps in the wiki.
#
# run_onchange_: re-runs whenever this rendered script changes. The file hashes
# embedded at the bottom make it re-run when any installed file changes.
set -euo pipefail

SRC="{{ .chezmoi.sourceDir }}/system"
WALLPAPERS="{{ .chezmoi.sourceDir }}/Pictures/Wallpapers"

install_file() {
    # $1 = path under system/ ; installed to the mirrored absolute path (root:root, 0644)
    sudo install -Dm644 "$SRC/$1" "/$1"
    echo "  installed /$1"
}

echo "Installing managed system files into /etc ..."

# --- shared on every machine ---
install_file "etc/locale.conf"
install_file "etc/resolvconf.conf"
install_file "etc/xdg/reflector/reflector.conf"
install_file "etc/pacman.d/hooks/mirrorupgrade.hook"
install_file "etc/pacman.d/hooks/nvidia.hook"
install_file "etc/pacman.d/hooks/systemd-boot.hook"
# nvidia suspend/resume: preserve VRAM allocations across sleep. Baked into the
# initramfs, so a change needs `sudo mkinitcpio -P` + reboot to take effect
# (on a fresh install this file is laid down before the nvidia section's build).
install_file "etc/modprobe.d/nvidia.conf"
# hand resolv.conf management to resolvconf (Cloudflare DNS setup).
install_file "etc/NetworkManager/conf.d/rc-manager.conf"
# noctalia-greeter: altgr-intl keyboard + Catppuccin appearance (declarative;
# greetd empties the env, so the layout must live here, not in a greetd env drop-in).
install_file "var/lib/noctalia-greeter/greeter.toml"

# Wallpapers, a second time, into a world-readable system path. They are already
# deployed to ~/Pictures/Wallpapers/ for the shell (that is the folder noctalia's
# wallpaper picker and its rotation use), but the greeter runs as the unprivileged
# greetd session user and cannot read $HOME -- so the same set is mirrored here and
# greeter.toml's [appearance.wallpaper] points at one of them.
echo "Installing wallpapers into /usr/share/backgrounds ..."
for wp in "$WALLPAPERS"/*; do
    [ -f "$wp" ] || continue
    sudo install -Dm644 "$wp" "/usr/share/backgrounds/$(basename "$wp")"
    echo "  installed /usr/share/backgrounds/$(basename "$wp")"
done

{{ if eq .machine "laptop" -}}
# --- laptop: stable Intel iGPU / NVIDIA dGPU DRM symlinks for AQ_DRM_DEVICES ---
install_file "etc/udev/rules.d/90-hypr-gpu.rules"
sudo udevadm control --reload
sudo udevadm trigger
{{- else -}}
# --- workstation: stable NVIDIA dGPU DRM symlink for AQ_DRM_DEVICES ---
install_file "etc/udev/rules.d/90-hypr-gpu-workstation.rules"
sudo udevadm control --reload
sudo udevadm trigger
{{- end }}

echo "Done."

# --- change detection (do not edit): source file hashes ---
# locale.conf         {{ include "system/etc/locale.conf" | sha256sum }}
# resolvconf.conf     {{ include "system/etc/resolvconf.conf" | sha256sum }}
# reflector.conf      {{ include "system/etc/xdg/reflector/reflector.conf" | sha256sum }}
# mirrorupgrade.hook  {{ include "system/etc/pacman.d/hooks/mirrorupgrade.hook" | sha256sum }}
# nvidia.hook         {{ include "system/etc/pacman.d/hooks/nvidia.hook" | sha256sum }}
# systemd-boot.hook   {{ include "system/etc/pacman.d/hooks/systemd-boot.hook" | sha256sum }}
# nvidia.conf         {{ include "system/etc/modprobe.d/nvidia.conf" | sha256sum }}
# rc-manager.conf     {{ include "system/etc/NetworkManager/conf.d/rc-manager.conf" | sha256sum }}
# greeter.toml        {{ include "system/var/lib/noctalia-greeter/greeter.toml" | sha256sum }}
# wallpapers, globbed -- adding or replacing an image in Pictures/Wallpapers/ makes
# this script re-run and mirror it into /usr/share/backgrounds/:
{{ range (glob (joinPath .chezmoi.sourceDir "Pictures/Wallpapers/*")) -}}
#   {{ base . }}  {{ include . | sha256sum }}
{{ end -}}
{{ if eq .machine "laptop" -}}
# 90-hypr-gpu.rules   {{ include "system/etc/udev/rules.d/90-hypr-gpu.rules" | sha256sum }}
{{- else -}}
# 90-hypr-gpu-workstation.rules   {{ include "system/etc/udev/rules.d/90-hypr-gpu-workstation.rules" | sha256sum }}
{{- end }}
