#!/usr/bin/env bash
#
# Apply the workstation's aRGB zone sizes and colour, standalone, before OpenRGB's
# resident server starts. Called from openrgb.service (ExecStartPre).
#
# IMPORTANT: run this with NO OpenRGB server running -- it is wired as the service's
# ExecStartPre, i.e. before `openrgb --server` starts. A standalone `openrgb` does
# its own detection and writes the hardware directly, which works. The same commands
# issued as an SDK CLIENT against a running server repeatedly returned exit 0 while
# the LEDs never changed, so colour must not be driven that way. Running this by hand
# while the service is up will therefore appear to succeed and do nothing: stop the
# service first (`systemctl --user stop openrgb`), or just restart it.
#
# Why a polling loop rather than `sleep N`:
# `openrgb --server` enumerates asynchronously. Measured at boot, 3 seconds in it
# had found only 2 of the 5 controllers and the ASUS Aura board was not among them,
# so the colour command died with `Cannot find device "ProArt"` and the lighting was
# left at whatever the controller happened to be holding. Because openrgb.service
# marks ExecStartPost with a leading "-", that failure was invisible: the unit still
# reported active, and the lighting only looked right because the Aura controller
# retains its last colour across a warm reboot.
#
# Why the loop retries the REAL command instead of probing with --list-devices:
# that probe is not equivalent. When the server is not yet accepting clients,
# --list-devices silently falls back to its own LOCAL detection and happily reports
# all 5 devices, while the apply goes to the server and fails. Checking one thing
# and doing another raced every time.
#
# The board (ASUS Aura) uses `static`: Direct blanks a minute or two after the last
# client disconnects.
#
# The DIMMs are NOT set through openrgb at all -- `ram-rgb` talks to them over SMBus
# directly. OpenRGB's ENE write path desyncs these modules' register pointer: colour
# bytes land in control registers, and ENE_REG_DIRECT (0x8020) repeatedly ends up
# holding 0xCC (a red colour byte) instead of 0x01. The module then stops honouring
# Direct mode and displays its EFFECT registers, while GetDeviceMode() reads that
# non-zero byte back as "Direct" and openrgb concludes no mode change is needed. The
# result is silent: every command exits 0, the direct colour registers hold exactly
# the right values, and the sticks show something else entirely -- stale colours from
# whatever was in the effect registers, which is why the "wrong" LEDs appear to move
# around between runs. ram-rgb writes each byte with an explicit address select and
# verifies by read-back, retrying until the registers and the direct flag are right.
#
# Why zone SIZES are asserted here rather than restored from a file -- addressable
# zones report 0 LEDs until sized, so detected headers look dead. That value used to
# live in a chezmoi-managed ~/.config/OpenRGB/sizes.ors, but OpenRGB 1.0 retired the
# format: it migrates any leftover to sizes.ors.bak and keeps the sizes in
# Configuration.json, which it rewrites on every run and which was never tracked. So
# nothing reproduced them on a fresh machine. Re-asserting them on every start fixes
# that and leaves Configuration.json as a cache nothing depends on.
#
# Why -sz is NOT its own command: `openrgb -d ProArt -z 0 -sz 120` on its own exits
# 255 with "Device 0 specified, but neither mode nor color given" -- the CLI grammar
# is `(--device [--mode] [--color])...`, so -z/-sz are modifiers on an apply, never an
# action. Issued standalone it fails every time, and since apply_all retries from the
# top, the unit sits in ExecStartPre burning 30 x (detect + 2s) and never starts the
# server. Folding the three sizes into the board's own colour command also cuts three
# full ~15s detection passes off every start.
#
# FF0000 = pure red, zero green/blue. Catppuccin's reds all render pink through the
# diffusers; see the OpenRGB section in wiki 06b. (FF4000 is the Windows colour, not
# this one.)
set -uo pipefail

HERE="$(dirname "$(readlink -f "$0")")"

# The PG32UCDM monitor (5 LEDs) is deliberately NOT managed here. Direct is its only
# mode, so it blanks as soon as the standalone apply exits -- it would have to be set
# after the server is up, i.e. as a client, which is the unreliable path. Not worth a
# half-working step for a light that is barely visible.
COLOR="FF0000"
BOARD="ProArt"
# Do NOT pass one colour per LED to the DIMMs. Spelling out all 8 (-c CC0000,CC0000,
# ...) takes a different write path in the ENE driver that lands one byte out of phase
# partway along the strip: the repeating CC 00 00 is then read as 00 00 CC, so half of
# each stick turns blue with a purple LED at the seam. A single -c is correct here --
# OpenRGB fills the remaining LEDs with the last colour given.
TRIES=30
SLEEP=2

apply_all() {
    # Board first: it enumerates last, so its success gates everything else. The zone
    # sizes ride along in the SAME invocation as the colour -- see the -sz note above.
    # 120 is the per-zone maximum; these are what the board runs (zone 0 full, 1/2 half).
    openrgb -d "$BOARD" -z 0 -sz 120 -z 1 -sz 60 -z 2 -sz 60 \
            -m static -c "$COLOR" >/dev/null 2>&1 || return 1
    # DIMMs are NOT driven through openrgb -- see the ENE note above. Absolute path:
    # the systemd user unit's PATH does not include ~/.local/bin.
    "$HERE/ram-rgb" "$COLOR" || return 1
}

for _ in $(seq 1 "$TRIES"); do
    if apply_all; then
        exit 0
    fi
    sleep "$SLEEP"
done

echo "openrgb-apply: failed to apply after $((TRIES * SLEEP))s" >&2
exit 1
