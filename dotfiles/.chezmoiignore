# Files in the chezmoi source that are NOT targets under $HOME.
# system/ is installed into /etc by .chezmoiscripts/run_onchange_install-system-files.sh
# (chezmoi can't manage files outside $HOME); README is repo documentation.
# (Wallpapers under dot_local/share/wallpapers/ ARE deployed.)
system
README.asciidoc

# OpenRGB aRGB state is workstation-only hardware (ASUS Aura + G.Skill DIMMs).
# Ignored anywhere that is NOT the workstation, so a future third machine role
# does not inherit lighting config for hardware it doesn't have.
{{ if ne .machine "workstation" -}}
.config/OpenRGB
.config/systemd/user/openrgb.service
.local/bin/openrgb-apply
{{ end -}}
